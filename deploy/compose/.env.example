# Template for deploy/compose/.env. Do NOT put real secrets in this file (INV-11).
# Run `dotnet run scripts/dev-env.cs` from the repository root: it replaces every CHANGE_ME below with a generated
# value and writes deploy/compose/.env (gitignored). Or copy this file to .env and fill the CHANGE_ME values by hand.

# --- Credentials (generated by scripts/dev-env.cs) ---
POSTGRES_PASSWORD=CHANGE_ME
REDIS_PASSWORD=CHANGE_ME
S3_ROOT_USER=CHANGE_ME
S3_ROOT_PASSWORD=CHANGE_ME

# --- JWT signing key ring (Auth:Jwt:SigningKeys:0, RSA-3072 PKCS#8 PEM, base64) ---
Auth__Jwt__SigningKeys__0__Kid=CHANGE_ME
Auth__Jwt__SigningKeys__0__Status=Active
Auth__Jwt__SigningKeys__0__PrivateKeyBase64=CHANGE_ME

# --- Host port overrides (all bound to 127.0.0.1); change one when the default is already in use ---
APP_PORT=8080
POSTGRES_PORT=5432
REDIS_PORT=6379
S3_PORT=9000
AZURITE_BLOB_PORT=10000
MAILPIT_UI_PORT=8025
MAILPIT_SMTP_PORT=1025
ASPIRE_UI_PORT=18888
ASPIRE_OTLP_PORT=18889

# --- Behaviour switches ---
# Blob provider: S3 (RustFS container) or AzureBlob (Azurite container, well-known dev account).
BLOB_PROVIDER=S3
S3_BUCKET=acme-service-blobs
# Absolute http(s) URLs put into emails; point them at your front end.
AUTH_CONFIRM_EMAIL_URL=http://localhost:3000/confirm-email
AUTH_RESET_PASSWORD_URL=http://localhost:3000/reset-password
# OTLP endpoint for traces/metrics/logs. Empty disables export. With `--profile observability` use
# http://aspire-dashboard:18889 and open http://localhost:18888.
OTLP_ENDPOINT=

{
  "ConnectionStrings": {
    "Postgres": "Host=localhost;Port=5432;Database=acme_service;Username=postgres",
    "PostgresMigrations": "Host=localhost;Port=5432;Database=acme_service;Username=postgres"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System.Net.Http.HttpClient": "Warning"
      }
    }
  },
  "Blob": {
    "Provider": "Local",
    "Local": {
      "RootPath": ".data/blobs"
    }
  },
  "Notifications": {
    "Provider": "Console"
  },
  "Jobs": {
    "Provider": "InMemory"
  },
  "Auth": {
    "Links": {
      "ConfirmEmailUrl": "http://localhost:3000/confirm-email",
      "ResetPasswordUrl": "http://localhost:3000/reset-password"
    }
  },
  "OpenApi": {
    "Enabled": true
  }
}

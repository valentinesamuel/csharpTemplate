{
  "ConnectionStrings": {
    "Postgres": "",
    "PostgresMigrations": ""
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.AspNetCore.Diagnostics": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System.Net.Http.HttpClient": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    }
  },
  "Observability": {
    "ServiceName": "acme-service",
    "Otlp": {
      "Endpoint": ""
    }
  },
  "Http": {
    "ForwardedHeaders": {
      "KnownNetworks": [],
      "KnownProxies": []
    }
  },
  "Cache": {
    "Provider": "InMemory"
  },
  "Blob": {
    "Provider": ""
  },
  "Notifications": {
    "Provider": ""
  },
  "Jobs": {
    "Provider": ""
  },
  "Locks": {
    "Provider": "Postgres"
  },
  "Auth": {
    "Jwt": {
      "Issuer": "acme-service",
      "Audience": "acme-service",
      "AccessTokenLifetime": "00:15:00",
      "RefreshTokenLifetime": "14.00:00:00",
      "SessionAbsoluteLifetime": "30.00:00:00",
      "ClockSkew": "00:00:30"
    },
    "DefaultRole": "Customer",
    "Mfa": {
      "Issuer": "acme-service"
    },
    "External": {
      "Oidc": {
        "Enabled": false,
        "DisplayName": "OpenID Connect",
        "Authority": "",
        "ClientId": "",
        "ClientSecret": "",
        "Scopes": [ "openid", "profile", "email" ],
        "AllowedReturnUrls": []
      }
    },
    "RateLimiting": {
      "Credentials": {
        "PermitLimit": 10,
        "Window": "00:01:00"
      },
      "Email": {
        "PermitLimit": 5,
        "Window": "00:01:00"
      }
    }
  },
  "OpenApi": {
    "Enabled": false
  },
  "AllowedHosts": "*"
}
